%!TEX TS-program = xelatex
%!TEX encoding = UTF-8 Unicode
% Generated by JobPilot CV Studio -- do not edit by hand.
% Source of truth is the structured JSON (cv_versions.content); edit that instead.
%
% Awesome CV LaTeX Template: https://github.com/posquit0/Awesome-CV
% Template license: CC BY-SA 4.0

%-------------------------------------------------------------------------------
% CONFIGURATIONS
%-------------------------------------------------------------------------------
\documentclass[11pt, a4paper]{awesome-cv}
\usepackage{tikz}
\usepackage{fontawesome}

\geometry{left=1.4cm, top=1.0cm, right=1.4cm, bottom=1.5cm, footskip=.5cm}

\fontdir[<< doc.theme.font_dir >>]

<% if doc.theme.color.startswith('#') %>
\definecolor{awesome}{HTML}{<< doc.theme.color[1:]|upper >>}
<% else %>
\colorlet{awesome}{<< doc.theme.color >>}
<% endif %>
\setbool{acvSectionColorHighlight}{<< 'true' if doc.theme.section_highlight else 'false' >>}

\renewcommand{\acvHeaderSocialSep}{\quad\textbar\quad}

%-------------------------------------------------------------------------------
% CUSTOM MACROS
%-------------------------------------------------------------------------------
% Highlight tech stack in bold + awesome color
\newcommand{\tech}[1]{\textbf{\textcolor{awesome}{#1}}}
% Front-end highlight in awesome skyblue
\newcommand{\techfe}[1]{\textbf{\textcolor{awesome-skyblue}{#1}}}

% Custom link with external icon
\usepackage{hyperref}
\newcommand{\hreficon}[2]{%
    \href{#1}{#2~\faExternalLink}%
}

%-------------------------------------------------------------------------------
% PERSONAL INFORMATION
%-------------------------------------------------------------------------------
\name{\textbf{<< h.first_name|tex >>}}{\tech{<< h.last_name|tex >>}}
\position{<< h.position|tex >>}
<% if h.address %>
\address{<< h.address|tex >>}
<% endif %>
<% if h.mobile %>
\mobile{<< h.mobile|tex >>}
<% endif %>
<% if h.email %>
\email{<< h.email|tex >>}
<% endif %>
<% if h.homepage %>
\homepage{<< h.homepage|tex >>}
<% endif %>
<% if h.extra_info %>
\extrainfo{\faHome\ \href{<< h.extra_info.url|url >>}{<< h.extra_info.label|tex >>}}
<% endif %>
<% if h.github %>
\github{<< h.github|tex >>}
<% endif %>
<% if h.linkedin %>
\linkedin{<< h.linkedin|tex >>}
<% endif %>
<% if h.quote %>
\quote{``<< h.quote|tex >>"}
<% endif %>

%-------------------------------------------------------------------------------
\begin{document}

\makecvheader[C]

%-------------------------------------------------------------------------------
% CV/RESUME CONTENT
%-------------------------------------------------------------------------------
<% for s in sections %>
\input{<< section_dir >>/<< s.key >>.tex}
<% endfor %>

%-------------------------------------------------------------------------------
\end{document}
