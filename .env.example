# Copy this file to ./.env at the REPO ROOT (same folder as this file), then fill in.
# config.py reads .env from the repo root (or cwd). NEVER commit .env (it's gitignored).

# ---- Database (Phase 2+) ----
DATABASE_URL=postgresql+psycopg://jobpilot:jobpilot@localhost:5432/jobpilot

# ---- Claude API (Phase 5 — tailor) ----
ANTHROPIC_API_KEY=

# ---- Web API auth (local single-user) ----
JOBPILOT_API_TOKEN=changeme

# ---- Slack (Phase 7 — secondary channel, optional) ----
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_CHANNEL_ID=

# ---- Email apply (Phase 6 — optional, full-auto channel) ----
# method=gmail uses OAuth; method=smtp uses the SMTP_* vars below.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
