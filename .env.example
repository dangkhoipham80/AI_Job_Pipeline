# Copy this file to ./.env at the REPO ROOT (same folder as this file), then fill in.
# config.py reads .env from the repo root (or cwd). NEVER commit .env (it's gitignored).

# ---- Database (Phase 2+) ----
DATABASE_URL=postgresql+psycopg://jobpilot:jobpilot@localhost:5432/jobpilot

# ---- Model providers (tailor / cover letter / inbox classify) ----
# Fill in the one(s) named by `llm` in jobpilot/config.yaml — only the
# configured provider's key is needed, and a missing one is reported before the
# task is queued rather than after.
#
# On data use (checked 2026-08-08): the Anthropic, OpenAI and paid Gemini APIs
# do not train on API input. Gemini's FREE tier does, and its terms say not to
# send personal information — while `tailor` and `letter` send the entire Master
# CV. If you use the free tier, set `llm.gemini_paid_tier: false` so JobPilot
# warns you each time.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ---- Web API auth (local single-user) ----
JOBPILOT_API_TOKEN=changeme

# ---- Slack (Phase 7 — secondary channel, optional) ----
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_CHANNEL_ID=

# ---- Email apply (Phase 6 — optional, full-auto channel) ----
# Credentials live here; the SAFETY GATES live in jobpilot/config.yaml under
# apply.email and ship closed. Open them one at a time:
#   1. enabled: true          nothing can be sent while this is false
#   2. test_recipient: you@…  delivers to you instead of the employer
#   3. dry_run: false         only now does mail actually leave the machine
# Drop test_recipient last, once you've seen a real message arrive correctly.
# method=smtp works with a Gmail app password; method=gmail (OAuth) is not
# implemented yet.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ---- LinkedIn Job Alerts via your own mailbox (Phase 9) ----
# JobPilot never touches LinkedIn's servers: LinkedIn emails you the jobs
# (Job Alerts), and this reads YOUR inbox. Gmail requires an App Password —
# enable 2-Step Verification, then create one at
# https://myaccount.google.com/apppasswords
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
